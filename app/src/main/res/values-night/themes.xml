<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色下的窗口外观:底色换成墨色,其余与亮色一致 -->
    <style name="Theme.Intersect" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mist</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/slate</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
